{
  "name": "pokeidle-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Aplicativo comunitário não oficial para gerenciar contas do Pokeidle e consultar informações do jogo",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/DiuleJR/pokeidle-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiuleJR/pokeidle-manager.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run lint && npm run typecheck && npm run test",
    "tauri": "tauri",
    "tauri:dev:community": "tauri dev -- --no-default-features --features community-build",
    "tauri:dev:smoke": "tauri dev --config src-tauri/tauri.smoke.conf.json --features community-build",
    "tauri:dev:mobile": "tauri dev -- --no-default-features --features community-build,mobile-local-server",
    "tauri:build:community": "tauri build -- --no-default-features --features community-build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tauri-apps/cli": "^2.9.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
